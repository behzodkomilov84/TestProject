# Nginx reverse proxy — SSL terminatsiya + Spring Boot ilovasiga proksi.
#
# Bu fayl "template" — nginx konteyneri ishga tushganda ${DOMAIN} avtomatik
# almashtiriladi (rasmiy nginx image'ning /etc/nginx/templates/ mexanizmi
# orqali) va natija /etc/nginx/conf.d/default.conf ga yoziladi. Boshqa $...
# (masalan $host, $remote_addr) — bular nginx'ning o'z ichki o'zgaruvchilari,
# ular ${...} qavs bilan yozilmagani uchun almashtirilmaydi.

# 1) Oddiy HTTP (80-port): faqat Let's Encrypt tekshiruvi (ACME challenge)
#    uchun ochiq, qolgan hamma narsa HTTPS'ga yo'naltiriladi.
server {
    listen 80;
    server_name ${DOMAIN};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# 2) HTTPS (443-port): sertifikat bilan shifrlangan trafik shu yerdan
#    ichki tarmoqdagi Spring Boot ilovasiga (app:8080) uzatiladi.
server {
    listen 443 ssl;
    http2 on;
    server_name ${DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;

    # Xavfsizlik header'lari
    add_header Strict-Transport-Security "max-age=63072000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;

    # application.yaml'dagi spring.servlet.multipart.max-request-size (55MB)
    # bilan mos — aks holda katta video izohlar nginx darajasida rad etiladi.
    client_max_body_size 55M;

    location / {
        proxy_pass http://app:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
