# Bu faylni ".env" nomi bilan nusxalab, haqiqiy qiymatlarni kiriting.
# ".env" fayli .gitignore orqali git'ga tushmaydi — sirlarni hech qachon commit qilmang.

# MySQL / Spring datasource
DB_USERNAME=root
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Telegram bot (BotFather'dan olingan haqiqiy token shu yerga)
# Eslatma: eski token (kod ichida ochiq turgan) allaqachon oshkor bo'lgan —
# BotFather orqali uni revoke qilib, yangi token oling.
TELEGRAM_BOT_TOKEN=CHANGE_ME_TELEGRAM_BOT_TOKEN
TELEGRAM_BOT_USERNAME=study_grow_bot

# Parolni tiklash — email kanali (Telegram ustuvor, bu faqat zaxira kanal).
# Brevo (avvalgi nomi Sendinblue) ishlatiladi — Gmail'dan farqli, 2FA/App
# Password kerak emas:
#   1. https://app.brevo.com'da bepul ro'yxatdan o'ting.
#   2. Chap menyudan: SMTP & API -> SMTP -> "sizning login (email)" va
#      "SMTP key" (Generate a new SMTP key) ni oling.
#   3. SMTP_USERNAME = shu login email, SMTP_PASSWORD = generatsiya qilingan
#      SMTP key (oddiy akkaunt paroli EMAS).
#   4. MAIL_FROM — Brevo'da tasdiqlangan (verified) jo'natuvchi email/domen
#      bo'lishi kerak, aks holda xat rad etiladi.
# Bepul tarif: kuniga ~300 email — kichik loyiha uchun yetarli.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=CHANGE_ME_BREVO_LOGIN_EMAIL
SMTP_PASSWORD=CHANGE_ME_BREVO_SMTP_KEY
MAIL_FROM=no-reply@smart-test.local

# Production'da HTTPS/SSL uchun (docker-compose.prod.yml + nginx + Let's
# Encrypt) — docs/DEPLOYMENT.md'ga qarang. Local dev'da kerak emas.
# DOMAIN — DNS'da shu serverning IP-manziliga yo'naltirilgan bo'lishi shart
# (Let's Encrypt "localhost" yoki IP-manzil uchun sertifikat bermaydi).
DOMAIN=CHANGE_ME_your-domain.com
LETSENCRYPT_EMAIL=CHANGE_ME_you@example.com
